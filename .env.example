# Heimdallr API Configuration - Law Enforcement Use Only
# Copy to .env and configure with your actual API keys

# =============================================================================
# TWITTER/X API CONFIGURATION
# =============================================================================
# Get keys from: https://developer.twitter.com
# Required for enhanced tweet searching and profile access

TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# =============================================================================
# REDDIT API CONFIGURATION
# =============================================================================
# Get keys from: https://reddit.com/prefs/apps
# Required for advanced subreddit access and missing persons searches

REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# =============================================================================
# INSTAGRAM CONFIGURATION (NOT RECOMMENDED)
# =============================================================================
# WARNING: Using credentials may violate Instagram ToS and cause suspension
# Web scraping mode is used by default without credentials

# INSTAGRAM_USERNAME=your_username
# INSTAGRAM_PASSWORD=your_password

# =============================================================================
# PROXY CONFIGURATION (OPTIONAL)
# =============================================================================
# For enhanced anonymity and bypassing geo-restrictions

# HTTP_PROXY=http://proxy-server:port
# HTTPS_PROXY=https://proxy-server:port
# PROXY_USERNAME=proxy_username
# PROXY_PASSWORD=proxy_password

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Advanced security and operational settings

# Encryption key for sensitive data (auto-generated if not provided)
# ENCRYPTION_KEY=your_32_character_hex_key_here

# Audit logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable evidence chain tracking (true/false)
EVIDENCE_CHAIN_ENABLED=true

# Secure deletion of temporary files (true/false)
SECURE_DELETE_ENABLED=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Tuning parameters for high-volume operations

# Maximum concurrent platform searches
MAX_CONCURRENT_SEARCHES=3

# Network timeout in seconds
NETWORK_TIMEOUT=30

# Cache size limit in MB
CACHE_SIZE_MB=500

# Auto-cleanup temporary files (true/false)
AUTO_CLEANUP=true

# =============================================================================
# BROWSER CONFIGURATION
# =============================================================================
# Selenium and browser automation settings

# Run browsers in headless mode (true/false)
HEADLESS_BROWSER=true

# Disable image loading for faster browsing (true/false)
DISABLE_IMAGES=false

# Enable user agent rotation (true/false)
USER_AGENT_ROTATION=true

# Custom user agent string (optional)
# CUSTOM_USER_AGENT=Mozilla/5.0 (compatible; LawEnforcementBot/1.0)

# =============================================================================
# AGENCY CONFIGURATION
# =============================================================================
# Agency-specific settings for compliance and tracking

# Agency identifier for audit logs
AGENCY_ID=your_agency_code

# Operator ID for tracking (filled during setup)
# OPERATOR_ID=badge_number_or_id

# Legal authority tracking
# LEGAL_AUTHORITY=warrant_or_case_number

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Expert-level configuration options

# Face recognition model (hog/cnn)
FACE_DETECTION_MODEL=hog

# Default similarity threshold (0.0-1.0)
DEFAULT_SIMILARITY_THRESHOLD=0.80

# Maximum results per platform
MAX_RESULTS_PER_PLATFORM=50

# Enable aggressive search mode by default (true/false)
DEFAULT_AGGRESSIVE_MODE=false

# =============================================================================
# DATABASE CONFIGURATION (OPTIONAL)
# =============================================================================
# For advanced case management and multi-user deployments

# DATABASE_URL=postgresql://user:password@localhost:5432/heimdallr
# DB_ENCRYPTION_KEY=your_database_encryption_key

# =============================================================================
# NOTIFICATION CONFIGURATION (OPTIONAL)
# =============================================================================
# For alerts and status updates

# EMAIL_SMTP_SERVER=smtp.agency.gov
# EMAIL_USERNAME=heimdallr@agency.gov
# EMAIL_PASSWORD=email_password
# ALERT_EMAIL=supervisor@agency.gov

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# =============================================================================
# SECURITY NOTICE
# =============================================================================
# This file contains sensitive information and should be:
# 1. Never committed to version control
# 2. Protected with restrictive file permissions (600)
# 3. Encrypted at rest if stored on shared systems
# 4. Regularly rotated and updated
# 5. Only accessible to authorized personnel
#
# File permissions should be set to 600:
# chmod 600 .env
